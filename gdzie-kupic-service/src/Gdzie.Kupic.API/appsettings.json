{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=gdziekupic;Username=gdzie-kupic;Password=gdzie-kupic-admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceName": "GdzieKupicService",
  "Jwt": {
    "Secret": "",
    "Issuer": "GdzieKupicService",
    "Audience": "GdzieKupicClient",
    "AccessTokenLifetimeDays": 7
  },
  "RefreshToken": {
    "LifetimeDays": 30
  },
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "FrontendCallbackUrl": "http://localhost:3000/oauth-callback"
  },
  "Hangfire": {
    "Storage": "Postgres",
    "SchemaName": "hangfire",
    "ServerEnabled": true,
    "PollingIntervalSeconds": 1,
    "RetryAttempts": 10
  },
  "Marketplace": {
    "JobsEnabled": true,
    "DefaultPostLifetimeHours": 72,
    "LongLivedPostDays": 14,
    "OutboxRelayIntervalSeconds": 5,
    "OutboxRelayBatchSize": 100,
    "ExpirePostsCron": "* * * * *"
  },
  "Storage": {
    "Endpoint": "",
    "PublicEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "attachments",
    "Region": "us-east-1",
    "AutoCreateBucket": false
  },
  "Chat": {
    "MaxAttachmentBytes": 5242880,
    "AttachmentUrlLifetimeMinutes": 15
  },
  "Seq": {
    "Url": "http://localhost:5341",
    "ApiKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
